{
  "name": "@agent-topology/spec",
  "version": "0.1.0-beta.1",
  "description": "TypeScript utilities and types for the agent-topology document contract",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-topology/agent-topology.git",
    "directory": "packages/typescript/spec"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/generate-contract.mjs && tsc -p tsconfig.json",
    "check": "npm run build && npm run format:check && tsc -p tsconfig.tests.json && node --test tests/*.test.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.json\" \"*.md\"",
    "prepack": "npm run build",
    "pack:check": "node ../../../scripts/verify_typescript_release.mjs pack --package spec --version 0.1.0-beta.1",
    "smoke": "node scripts/smoke-install.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
