{
  "name": "@agent-topology/langgraph",
  "version": "0.1.0-beta.1",
  "description": "Describe compiled LangGraph.js graphs as canonical agent-topology documents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run check:compatibility && npm run build && npm run format:check && tsc -p tsconfig.tests.json && node --test tests/*.test.mjs",
    "check:compatibility": "node scripts/check-compatibility.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.json\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.json\" \"*.md\"",
    "prepack": "npm run build",
    "pack:check": "node ../../../scripts/verify_typescript_release.mjs pack --package langgraph --version 0.1.0-beta.1 --spec-version 0.1.0-beta.1"
  },
  "dependencies": {
    "@langchain/langgraph": "1.4.14"
  },
  "peerDependencies": {
    "@agent-topology/spec": "0.1.0-beta.1"
  },
  "devDependencies": {
    "@agent-topology/spec": "file:../spec",
    "@types/node": "22.20.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
