{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-topology.schema.json",
  "title": "Agent Topology Document",
  "description": "The provisional v0.1 contract for a derived agent topology document.",
  "type": "object",
  "required": [
    "topologyVersion",
    "provenance",
    "producerLimitations",
    "structureHash",
    "graphs",
    "completeness"
  ],
  "properties": {
    "topologyVersion": {
      "const": "0.1",
      "description": "Version of this document contract; independent of package and hash versions."
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "producerLimitations": {
      "type": "array",
      "description": "Producer-wide blind spots that do not make this document incomplete.",
      "items": {
        "$ref": "#/$defs/producerLimitation"
      }
    },
    "structureHash": {
      "$ref": "#/$defs/structureHash"
    },
    "graphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/graph"
      }
    },
    "completeness": {
      "$ref": "#/$defs/completeness"
    }
  },
  "patternProperties": {
    "^x-[a-z0-9][a-z0-9._-]*$": true
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": ["generatedAt", "producer", "framework"],
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "$ref": "#/$defs/namedVersion"
        },
        "framework": {
          "$ref": "#/$defs/namedVersion"
        },
        "source": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            }
          },
          "patternProperties": {
            "^x-[a-z0-9][a-z0-9._-]*$": true
          },
          "additionalProperties": false
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9._-]*$": true
      },
      "additionalProperties": false
    },
    "namedVersion": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9._-]*$": true
      },
      "additionalProperties": false
    },
    "producerLimitation": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "$ref": "#/$defs/identifier"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9._-]*$": true
      },
      "additionalProperties": false
    },
    "structureHash": {
      "type": "object",
      "required": ["algorithm", "algorithmVersion", "value"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "algorithmVersion": {
          "const": "1",
          "description": "Version of canonicalisation and hash coverage, independent of topologyVersion."
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9._-]*$": true
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "required": ["id", "structure"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "structure": {
          "$ref": "#/$defs/graphStructure"
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9._-]*$": true
      },
      "additionalProperties": false
    },
    "graphStructure": {
      "type": "object",
      "required": ["nodes", "edges", "joins", "entryNodeIds", "exitNodeIds"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "joins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/join"
          }
        },
        "entryNodeIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "exitNodeIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9._-]*$": true
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "subgraphId": {
          "$ref": "#/$defs/identifier"
        },
        "interrupts": {
          "type": "array",
          "items": {
            "enum": ["before", "after"]
          },
          "uniqueItems": true
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9._-]*$": true
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target", "kind"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": ["direct", "conditional"]
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9._-]*$": true
      },
      "additionalProperties": false
    },
    "join": {
      "type": "object",
      "required": ["id", "sources", "target"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "target": {
          "$ref": "#/$defs/identifier"
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9._-]*$": true
      },
      "additionalProperties": false
    },
    "completeness": {
      "type": "object",
      "required": ["status", "gaps"],
      "properties": {
        "status": {
          "enum": ["complete", "incomplete"]
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          }
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9._-]*$": true
      },
      "additionalProperties": false
    },
    "gap": {
      "type": "object",
      "required": ["code", "message", "element"],
      "properties": {
        "code": {
          "$ref": "#/$defs/identifier"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "element": {
          "$ref": "#/$defs/elementReference"
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9._-]*$": true
      },
      "additionalProperties": false
    },
    "elementReference": {
      "type": "object",
      "required": ["graphId", "kind", "id"],
      "properties": {
        "graphId": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": ["graph", "node", "edge", "join"]
        },
        "id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": false
    }
  }
}
